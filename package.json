{
	"name": "manamurah-mcp-server",
	"version": "2.11.0",
	"description": "Remote MCP (Model Context Protocol) server for Malaysian PriceCatcher consumer price data — 15 strongly-typed tools + 6 reference resources + 4 guided prompts (with argument autocomplete) for AI agents, deployed on Cloudflare Workers.",
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev",
		"build": "tsc --noEmit",
		"deploy": "wrangler deploy",
		"type-check": "tsc --noEmit",
		"gen:catalogue": "node scripts/gen-catalogue.mjs",
		"test": "node --import tsx --test tests/*.test.ts"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"malaysia",
		"pricecatcher",
		"kpdn",
		"price-data",
		"claude-desktop",
		"cloudflare-workers",
		"data.gov.my"
	],
	"author": "manamurah.com",
	"license": "MIT",
	"files": [
		"src/**/*",
		"wrangler.toml",
		"README.md",
		"LICENSE"
	],
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260520.1",
		"tsx": "^4.22.3",
		"typescript": "^5.5.0",
		"wrangler": "^4.93.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/manamurah/mcp-server"
	},
	"homepage": "https://mcp.manamurah.com"
}
